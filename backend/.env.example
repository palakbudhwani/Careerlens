# CareerLens Backend Configuration
# Copy this file to backend/.env and fill in the values you need.
# backend/.env is git-ignored and must never be shared or zipped up.
# Leaving every key blank is valid: the backend then runs in keyless
# rule-based mode with no external AI calls (see the README).

# Port to run the server on (deployment platforms set this themselves)
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# Extra browser origins allowed to call this API, comma separated.
# Localhost/127.0.0.1 origins are always allowed outside production.
# Set this for production deployments (e.g. https://your-app.example.com).
CORS_ORIGINS=

# AI provider routing: gemini (primary), groq (fallback), or none (local fallbacks, no AI calls)
#
# Leave AI_PROVIDER unset (or blank) for auto-selection:
#   - GEMINI_API_KEY set        -> Gemini primary
#   - only GROQ_API_KEY set     -> Groq primary
#   - no keys set               -> keyless rule-based mode (no AI calls at all)
# Set AI_PROVIDER=none to force keyless mode even when keys are present.
# Setting AI_PROVIDER=gemini/groq WITHOUT the matching key makes AI endpoints
# return a clear 503 AI_NOT_CONFIGURED error instead of the local fallbacks.
# AI_PROVIDER=
# AI_FALLBACK_PROVIDER=groq
#
# Fallback behaviour: every AI request tries the primary first; on an eligible
# failure (429, transient network/timeout/upstream errors, invalid generated
# JSON) the fallback is tried exactly once. Config/invalid-request errors are
# not retried. Only enable a fallback provider whose key you have actually set.

# Google Gemini API key (primary provider - Gemini Flash)
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: override the Gemini Flash model (defaults to gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Groq API key (fallback provider; becomes the primary when GEMINI_API_KEY is blank)
# Get one from: https://console.groq.com/keys
GROQ_API_KEY=

# Groq model to use (strict structured outputs supported on
# openai/gpt-oss-120b, openai/gpt-oss-20b, and qwen/qwen3.8-27b;
# other models automatically fall back to best-effort JSON mode)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: override the Groq endpoint (proxy or local mock testing)
# GROQ_API_URL=

# --- Optional tuning (safe to omit; defaults shown) ---
# Cache for successful AI results (ms). 0 disables the cache.
# AI_RESULT_CACHE_TTL_MS=300000
# AI_RESULT_CACHE_MAX=100
# Short pause before the fallback provider is tried after an eligible failure.
# AI_FALLBACK_BACKOFF_MS=200
# AI_FALLBACK_BACKOFF_MAX_MS=1500
# Cap on simultaneous provider requests.
# AI_MAX_CONCURRENT_PROVIDER_CALLS=4
