# CareerLens frontend configuration (Vite).
# Copy this file to `.env` in the project root only when you need to override
# the API location. Nothing is required for local development.
#
# Local default (used when this variable is empty or unset):
#   VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1
#
# Deployed example:
#   VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=

# Optional: port for the Vite dev server (default 5173). The backend port is
# set separately in backend/.env with PORT.
# VITE_PORT=5173
