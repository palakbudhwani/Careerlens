{
  "name": "careerlens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"web,api\" --prefix-colors \"cyan,magenta\" \"vite\" \"node backend/server.js\"",
    "dev:web": "vite",
    "dev:api": "node backend/server.js",
    "build": "tsc -b && vite build",
    "postinstall": "npm --prefix backend install",
    "lint": "oxlint",
    "test": "npm --prefix backend test && vitest run",
    "preview": "vite preview",
    "package:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\package-zip.ps1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "jsdom": "^30.1.2",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.3"
  }
}
